<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/horizontal_flex"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextClock
            android:id="@+id/time_horizontal_hours_flex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_flex"
            android:includeFontPadding="false"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:id="@+id/time_horizontal_colon_flex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_flex"
            android:includeFontPadding="false"
            android:gravity="center"
            android:text=":"
            android:maxLines="1" />

        <TextClock
            android:id="@+id/time_horizontal_minutes_flex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_flex"
            android:includeFontPadding="false"
            android:gravity="center"
            android:maxLines="1" />
    </LinearLayout>

    <TextClock
        android:id="@+id/date_horizontal_flex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans_flex"
        android:includeFontPadding="false"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:maxLines="1" />
</LinearLayout>
