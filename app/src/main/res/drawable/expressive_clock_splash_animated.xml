<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/expressive_clock_splash_vector">

    <target
        android:name="outer_group"
        android:animation="@animator/splash_outer_pop" />

    <target
        android:name="hour_hand"
